FIREBASE_PROJECT_ID=claimelens
FIREBASE_API_KEY=YOUR_FIREBASE_APP_API_KEY
# Absolute path on the API server only. Never add this JSON file to Git.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/firebase-admin.json
# Private folder outside Git; files remain on the API computer.
DOCUMENT_STORAGE_PATH=C:/path/outside/repository/claimelens-documents
PUBLIC_API_URL=http://127.0.0.1:8000
PADDLE_DEVICE=cpu
MAX_UPLOAD_BYTES=10485760
MAX_CLAIM_DOCUMENTS=10
CORS_ORIGINS=
